# Database
DATABASE_URL=postgresql://calorie:calorie@localhost:5432/calorie_tracker

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# API
PORT=3000
API_URL=http://localhost:3000
ALLOW_REGISTRATION=true

# External food APIs
USDA_API_KEY=your-usda-api-key-here
