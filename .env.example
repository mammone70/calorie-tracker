# Database (local dev — used by docker compose.yml)
DATABASE_URL=postgresql://calorie:calorie@localhost:5432/calorie_tracker

# Only needed if you run docker-compose.prod.yml locally (normally production VPS only)
POSTGRES_USER=calorie
POSTGRES_PASSWORD=calorie
POSTGRES_DB=calorie_tracker

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_TRUSTED_ACCESS_EXPIRES_IN=1h
JWT_TRUSTED_REFRESH_EXPIRES_IN=90d

# API
PORT=3000
API_URL=http://localhost:3000
ALLOW_REGISTRATION=true

# External food APIs
USDA_API_KEY=your-usda-api-key-here
