# Copy to /opt/calorie-tracker/.env on the VPS and fill in all values.
# Never commit the real .env file.

# --- Domain (documentation only; nginx server_name is in deploy/nginx/calorie-tracker.conf) ---
# PRODUCTION_WEB_DOMAIN=cal-count.mammonesoftware.org
# PRODUCTION_API_DOMAIN=api.cal-count.mammonesoftware.org

# --- Postgres (internal to Docker network only) ---
POSTGRES_USER=calorie
POSTGRES_PASSWORD=change-me-use-openssl-rand-hex-32
POSTGRES_DB=calorie_tracker

# --- API ---
PORT=3000
NODE_ENV=production
WEB_ORIGIN=https://cal-count.mammonesoftware.org
ALLOW_REGISTRATION=false

# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_TRUSTED_ACCESS_EXPIRES_IN=1h
JWT_TRUSTED_REFRESH_EXPIRES_IN=90d

# Optional: USDA FoodData Central API key for food search
USDA_API_KEY=

# --- Backups (optional, for deploy/scripts/backup-db.sh) ---
# BACKUP_DIR=/opt/calorie-tracker/backups
# BACKUP_RETENTION_DAYS=7
# BACKUP_OFFSITE_RETENTION_DAYS=14
# Google Drive (rclone remote named "gdrive"; configure as deploy user — see deploy/BACKUP.md):
# RCLONE_REMOTE=gdrive:calorie-tracker-backups
# Or Backblaze B2 / S3:
# RCLONE_REMOTE=b2:calorie-tracker-backups
